# Polar AccessLink — https://admin.polaraccesslink.com
POLAR_CLIENT_ID=
POLAR_CLIENT_SECRET=
# Doit etre IDENTIQUE ici et sur admin.polaraccesslink.com.
# 8080 est souvent deja pris sous Windows : ce projet utilise 8000.
POLAR_REDIRECT_URI=http://localhost:8000/callback
CALLBACK_PORT=8000

# PostgreSQL (docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digitaltwin
POSTGRES_USER=twin
POSTGRES_PASSWORD=twin_local_dev

# Fuseau applique aux horodatages Polar livres sans timezone
LOCAL_TZ=Europe/Paris

# SQL_ECHO=1 pour voir chaque requete SQL emise par SQLAlchemy
SQL_ECHO=0

# Capteur de chambre (V4) - laisser vide tant que le module n'existe pas.
# L'IP est affichee sur le moniteur serie au demarrage de l'ESP32.
BEDROOM_SENSOR_URL=
